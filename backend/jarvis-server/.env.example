POSTGRES_PASSWORD=replace-with-random-password
# Postgres connection (matches docker-compose, port 5433 to avoid clash with system pg)
DATABASE_URL=postgresql://jarvis:replace-with-random-password@localhost:5433/jarvis

# API key — clients must send this in X-API-Key header. Rotate before production.
API_KEY=replace-with-random-api-key

HOST=0.0.0.0
PORT=8000

# Embedding model — both are 1024-dim, drop-in swappable.
#   nlpai-lab/KURE-v1   → Korean-focused (BGE-M3 한국어 파인튜닝)
#   BAAI/bge-m3         → multilingual baseline
EMBEDDING_MODEL=nlpai-lab/KURE-v1
EMBEDDING_DIM=1024
FACE_EMBEDDING_DIM=512

# cpu | cuda | mps
EMBEDDING_DEVICE=cpu

# OpenAI meeting transcription/summarization (server-side only)
OPENAI_API_KEY=
# GPT_API_KEY is also accepted as a backward-compatible alias.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
OPENAI_REASONING_EFFORT=low

# Jarvis Agent / MCP orchestration
JARVIS_ROUTER_MODEL=gpt-4.1-mini
JARVIS_PLANNER_MODEL=gpt-4.1-mini
JARVIS_ANSWER_MODEL=gpt-4.1-mini

# OAuth integrations. Fill these when enabling each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_DEFAULT_CHANNEL_ID=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# 앱 로그인과 사용자 분리
# ADMIN_EMAIL 구글 계정으로 처음 로그인하면 로그인 도입 전 기록(default)을 이어받는다.
ADMIN_EMAIL=
# 구글 플레이 서비스가 없는 에뮬레이터용 이메일 로그인. 운영 서버에서는 켜지 않는다.
ALLOW_DEV_LOGIN=false
# Gemini Live 중계. 앱에서 빼낸 게이트웨이 주소와 키를 서버에만 둔다.
GEMINI_LIVE_URL=
GEMINI_LIVE_KEY=

# 외부 서비스(구글, 슬랙, 노션) 연결 토큰을 DB 에 암호화해 저장하는 키. DB 와 따로 보관한다.
# 만들기: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 운영(ADMIN_EMAIL 이 있는 서버)에서는 이 키가 없으면 서버가 뜨지 않는다. 키를 잃으면 저장된 연결을 모두 다시 해야 한다.
# 기존 평문 줄 바꾸기: python scripts/encrypt_tokens.py (확인만) → python scripts/encrypt_tokens.py --apply
TOKEN_ENCRYPTION_KEY=

# 사용자 한 명의 하루(한국 날짜) AI 사용 한도. 0 이면 한도 없음. 관리자 계정(default)은 세지 않는다(D65).
# 실시간 대화 시간(분), 회의 녹음 정리 횟수, 서버 에이전트·Flash 중계 호출 횟수.
AI_LIMIT_LIVE_MINUTES=240
AI_LIMIT_MEETINGS=20
AI_LIMIT_AGENT_CALLS=1000

# 노션·슬랙 외부 도구 연결(D80): 모든 사용자를 합친 동시 연결 수 상한과, 안 쓰는 연결을 닫기까지의 시간(초).
# 실행 중인 요청이 있는 연결은 닫지 않는다. 상한에 걸리면 앱에 "잠시 뒤에 다시 시도해 주세요"라고 안내한다.
MCP_MAX_SESSIONS=40
MCP_IDLE_TIMEOUT_S=600
