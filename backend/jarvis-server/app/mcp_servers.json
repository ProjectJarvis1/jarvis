{
  "_comment": "외부 MCP 서버와 앱에 내보낼 도구 목록. 비밀값은 여기 두지 않고 계정 연결(DB)에서 읽는다. upstream 이름이 실제 서버에 없으면 건너뛰고 로그에 실제 목록을 남긴다.",
  "servers": {
    "notion": {
      "transport": "http",
      "url": "https://mcp.notion.com/mcp",
      "auth": "notion_mcp",
      "tools": {
        "notion_search": {
          "upstream": "notion-search",
          "title": "노션 검색",
          "description": "사용자가 노션을 말할 때만 씁니다. 연결된 노션에서 페이지와 데이터베이스를 찾습니다. 결과의 id로 notion_read_page를 부를 수 있습니다.",
          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "description": "찾을 내용의 핵심 단어"
              }
            },
            "required": [
              "query"
            ]
          }
        },
        "notion_read_page": {
          "upstream": "notion-fetch",
          "title": "노션 페이지 읽기",
          "description": "notion_search로 찾은 노션 페이지의 본문을 읽습니다. 사용자가 그 페이지 내용을 물을 때 씁니다.",
          "parameters": {
            "type": "object",
            "properties": {
              "page_id": {
                "type": "string",
                "description": "notion_search 결과의 id 또는 주소"
              }
            },
            "required": [
              "page_id"
            ]
          },
          "build": "notion_fetch"
        },
        "notion_create_page": {
          "upstream": "notion-create-pages",
          "title": "노션에 새 페이지 만들기",
          "description": "사용자가 노션에 적어 달라고 할 때 새 페이지를 만들어 내용을 적습니다. 앱이 실행 전에 사용자 확인을 받습니다.",
          "parameters": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "페이지 제목"
              },
              "content": {
                "type": "string",
                "description": "적을 내용(마크다운)"
              }
            },
            "required": [
              "title",
              "content"
            ]
          },
          "build": "notion_create",
          "confirm": true,
          "preview": "노션에 '{title}' 페이지를 만들까요?\n{content}"
        }
      }
    },
    "slack": {
      "transport": "http",
      "url": "https://mcp.slack.com/mcp",
      "auth": "slack_user",
      "tools": {
        "slack_search": {
          "upstream": "slack_search_public_and_private",
          "title": "슬랙 검색",
          "description": "사용자가 슬랙을 말할 때 슬랙 메시지를 검색합니다."
        },
        "slack_read_channel": {
          "upstream": "slack_read_channel",
          "title": "슬랙 채널 읽기",
          "description": "사용자가 슬랙 채널의 최근 대화를 물을 때 읽습니다."
        },
        "slack_send_message": {
          "upstream": "slack_send_message",
          "title": "슬랙 메시지 보내기",
          "description": "사용자가 슬랙에 메시지를 보내 달라고 할 때 씁니다. 앱이 실행 전에 사용자 확인을 받습니다.",
          "confirm": true
        }
      }
    }
  }
}
